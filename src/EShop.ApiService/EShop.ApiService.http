@ApiService_HostAddress = http://localhost:5318
@ProductId = 10000000-0000-0000-0000-000000000001
@OrderId = 20000000-0000-0000-0000-000000000001

### Get all products
GET {{ApiService_HostAddress}}/api/products/
Accept: application/json

###

### Get a product by ID
GET {{ApiService_HostAddress}}/api/products/{{ProductId}}
Accept: application/json

###

### Create a product
POST {{ApiService_HostAddress}}/api/products/
Content-Type: application/json

{
  "name": "USB-C Dock",
  "description": "Docking station with dual display support.",
  "sku": "ACC-DCK-006",
  "price": 129.99,
  "stockQuantity": 15,
  "category": "Accessories",
  "isActive": true
}

###

### Update a product
PUT {{ApiService_HostAddress}}/api/products/{{ProductId}}
Content-Type: application/json

{
  "name": "Wireless Mouse",
  "description": "Ergonomic wireless mouse, updated description.",
  "sku": "ACC-MOU-001",
  "price": 31.99,
  "stockQuantity": 40,
  "category": "Accessories",
  "isActive": true
}

###

### Delete a product
DELETE {{ApiService_HostAddress}}/api/products/{{ProductId}}

###

### Get all orders
GET {{ApiService_HostAddress}}/api/orders/
Accept: application/json

###

### Get an order by ID
GET {{ApiService_HostAddress}}/api/orders/{{OrderId}}
Accept: application/json

###

### Create an order
POST {{ApiService_HostAddress}}/api/orders/
Content-Type: application/json

{
  "customerName": "Morgan Ellis",
  "customerEmail": "morgan.ellis@example.com",
  "items": [
    {
      "productId": "10000000-0000-0000-0000-000000000001",
      "productName": "Wireless Mouse",
      "quantity": 2,
      "unitPrice": 29.99
    }
  ]
}

###

### Update an order
PUT {{ApiService_HostAddress}}/api/orders/{{OrderId}}
Content-Type: application/json

{
  "customerName": "Jordan Lee",
  "customerEmail": "jordan.lee@example.com",
  "status": "Confirmed",
  "items": [
    {
      "productId": "10000000-0000-0000-0000-000000000001",
      "productName": "Wireless Mouse",
      "quantity": 3,
      "unitPrice": 29.99
    }
  ]
}

###

### Delete an order
DELETE {{ApiService_HostAddress}}/api/orders/{{OrderId}}

###